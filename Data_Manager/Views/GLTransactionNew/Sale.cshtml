    @*//Load CSS*@
    <style>
        #globalLoader {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            display: none;
            justify-content: center;
            align-items: center;
            background: rgba(255,255,255,.35);
            backdrop-filter: blur(6px);
            z-index: 999999;
            animation: fadeIn .25s ease;
        }

        /* Loader Card */

        .loader-card {
            background: #fff;
            padding: 35px 45px;
            border-radius: 18px;
            box-shadow: 0 15px 40px rgba(0,0,0,.18);
            text-align: center;
            animation: popup .30s ease;
        }

        /* Spinner */

        .loader-spinner {
            width: 70px;
            height: 70px;
            border: 6px solid #e5e5e5;
            border-top: 6px solid #0d6efd;
            border-radius: 50%;
            margin: auto;
            animation: spin 1s linear infinite;
        }

        .loader-card h5 {
            margin-top: 18px;
            margin-bottom: 5px;
            font-weight: 600;
        }

        .loader-card small {
            color: #777;
        }

        /* Animations */

        @@keyframes spin {

            from {
                transform: rotate(0deg);
            }

            to {
                transform: rotate(360deg);
            }
        }

        @@keyframes popup {

            from {
                transform: scale(.8);
                opacity: 0;
            }

            to {
                transform: scale(1);
                opacity: 1;
            }
        }

        @@keyframes fadeIn {

            from {
                opacity: 0;
            }

            to {
                opacity: 1;
            }
        }
    </style>



    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/css/cssnew/js/script.js"></script>
    <script src="~/js/plugins/jquery/jquery.min.js"></script>
    <script>

        // Show Loader
        function ShowLoader() {

            $("#globalLoader")
                .css("display", "flex")
                .hide()
                .fadeIn(200);

        }

        // Hide Loader
        function HideLoader() {

            $("#globalLoader").fadeOut(200);

        }

        // Page Load
        $(window).on("beforeunload", function () {

            ShowLoader();

        });

        // Page Fully Loaded
        $(window).on("load", function () {

            HideLoader();

        });

        // All AJAX Requests
        $(document).ajaxStart(function () {

            ShowLoader();

        });

        $(document).ajaxStop(function () {

            HideLoader();

        });

        $("a").click(function () {

            ShowLoader();

        });
        $("form").submit(function () {

            ShowLoader();

        });
        window.addEventListener("pageshow", function (event) {
            HideLoader();
        });

        function LoadPartyList(empId) {

            $.ajax({

                url: '/GLTransactionNew/GetPartyHeader',
                type: 'GET',

                data: { empId: empId },

                success: function (res) {

                    $("#partyList").empty();
                    console.log(res);
                    $.each(res, function (i, item) {

                        var balanceClass = item.Balance >= 0 ? "text-success" : "text-danger";

                        var html = `
                            <div class="party-card" data-id="${item.EmpID}">

                                <div class="party-left">

                                    <div class="party-icon">

                                        <i class="fa-solid fa-store"></i>

                                    </div>

                                    <div>

                                        <h5 data-name="${item.Name}">${item.Name}</h5>

                                        <small data-cell="${item.CellNo}">${item.CellNo}</small>

                                    </div>

                                </div>

                                <div class="party-right">

                                    <small>Total Balance</small>

                                    <h6 class="${balanceClass}">

                                        Rs. ${item.Balance.toLocaleString()}

                                    </h6>

                                </div>

                            </div>
                        `;

                        $("#partyList").append(html);

                    });

                }

            });

        }





        $(document).ready(function () {
            LoadPartyList(1);
        });




        var selectedEmpId = 0;
        function LoadLedger(empId) {
            selectedEmpId = empId;
            $.ajax({
                url: "/GLTransactionNew/GetLedger",
                type: "GET",
                dataType: "json",
                data: {
                    empId: empId,
                    fromDate: $("#FromDate").val(),
                    toDate: $("#ToDate").val(),
                    search: null
                },
                success: function (res) {
                    $("#ledgerBody").empty();

                    if (!res || res.length === 0) {
                        $("#ledgerBody").append(`
                                <tr>
                                    <td colspan="7" class="text-center text-danger fw-bold py-4">
                                        <i class="fa fa-exclamation-circle me-2"></i>
                                        No Data Found
                                    </td>
                                </tr>
                            `);
                        return;
                    }
                    $.each(res, function (i, item) {
                        var transType = "";
                        if (item.SaleMst_ID > 0)
                            transType = "Sale";
                        else if (item.Payment_ID > 0)
                            transType = "Payment";
                        else
                            transType = "Opening";
                        var html =
                            '<tr>' +

                            '<td>' + item.Acc_Trans_ID + '</td>' +

                            '<td>' + formatDate(item.CreateDate) + '</td>' +

                            '<td>' + (item.Particular || "") + '</td>' +

                            '<td>' + transType + '</td>' +

                            '<td class="text-end"><a style="color:green" href="/SaleMaster/PrintInvoice?saleMstId=9062">' +
                            Number(item.DR_Amount || 0).toLocaleString() +
                            '</a></td>' +

                            '<td class="text-end" ><a style="color:red" href="/SaleMaster/PrintInvoice?saleMstId=' + item.SaleMst_ID + '">' +
                            Number(item.CR_Amount || 0).toLocaleString() +
                            '</a></td>' +

                            '<td class="text-end fw-bold" >' +
                            Number(item.Balance || 0).toLocaleString() +
                            '</td>' +

                            '</tr>';

                        $("#ledgerBody").append(html);

                    });

                },

                error: function (xhr) {

                    console.log(xhr.responseText);

                }

            });

        }


        function LoadPartySummary(empId) {

            $.ajax({
                url: "/GLTransactionNew/GetPartySummary",
                type: "GET",
                data: {
                    empId: empId
                },
                dataType: "json",
                success: function (res) {
                    if (res != null) {

                        var totalSale = Number(res.TotalSale || 0);
                        var totalReceive = Number(res.TotalReceive || 0);

                        var totalBalance = totalSale - totalReceive;

                        $("#TotalSale").text("Rs." + totalSale.toLocaleString());

                        $("#TotalReceive").text("Rs." + totalReceive.toLocaleString());

                        $("#TotalBalance").text("Rs." + totalBalance.toLocaleString());

                    }
                },
                error: function (xhr) {
                    console.log(xhr.responseText);
                }

            });

        }




        function formatDate(jsonDate) {

            if (!jsonDate)
                return "";
            var timestamp = parseInt(jsonDate.substr(6));
            var d = new Date(timestamp);
            var months = [
                "Jan", "Feb", "Mar", "Apr", "May", "Jun",
                "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"
            ];
            var day = ("0" + d.getDate()).slice(-2);
            var month = months[d.getMonth()];
            var year = d.getFullYear();

            return day + "-" + month + "-" + year;
        }

        $(document).on("click", ".party-card", function () {
            $(".party-card").removeClass("active");
            $(this).addClass("active");
            var empId = $(this).data("id");
            $('#activename').text($(this).find("h5").data("name"));
            $('#activecell').text($(this).find("small").data("cell"));
            LoadLedger(empId); // Ledger load function
            LoadPartySummary(empId);

        });

        function ClearFilter() {

            $("#FromDate").val("");
            $("#ToDate").val("");
            LoadLedger(selectedEmpId);
        }

