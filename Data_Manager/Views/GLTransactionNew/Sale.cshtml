        async function exportToExcel() {
            let fileName = $('#activename').text().trim();
            const workbook = new ExcelJS.Workbook();
            const worksheet = workbook.addWorksheet("Ledger");

            // Page Setup
            worksheet.pageSetup = {
                orientation: "landscape",
                fitToPage: true,
                paperSize: 9
            };

            // Company Name
            worksheet.mergeCells("A1:G1");
            worksheet.getCell("A1").value = "SCC";
            worksheet.getCell("A1").font = { size: 18, bold: true };
            worksheet.getCell("A1").alignment = { horizontal: "center" };

            // Report Name
            worksheet.mergeCells("A2:G2");
            worksheet.getCell("A2").value = fileName;
            worksheet.getCell("A2").font = { size: 14, bold: true };
            worksheet.getCell("A2").alignment = { horizontal: "center" };

            // Date
            worksheet.mergeCells("A3:G3");
            worksheet.getCell("A3").value = "Generated : " + new Date().toLocaleString();
            worksheet.getCell("A3").alignment = { horizontal: "right" };

            // Blank Row
            worksheet.addRow([]);

            // Header
            const table = document.querySelector("table");
            const headers = [];

            table.querySelectorAll("thead th").forEach(th => {
                headers.push(th.innerText.trim());
            });

            worksheet.addRow(headers);

            const headerRow = worksheet.getRow(5);

            headerRow.eachCell(cell => {

                cell.font = {
                    bold: true,
                    color: { argb: "000000" }
                };

                cell.fill = {
                    type: "pattern",
                    pattern: "solid",
                    fgColor: { argb: "D9D9D9" }
                };

                cell.alignment = {
                    horizontal: "center",
                    vertical: "middle"
                };

                cell.border = {
                    top: { style: "thin" },
                    left: { style: "thin" },
                    bottom: { style: "thin" },
                    right: { style: "thin" }
                };

            });

            // Data
            table.querySelectorAll("tbody tr").forEach(tr => {

                const td = tr.querySelectorAll("td");

                worksheet.addRow([
                    td[0].innerText.trim(),
                    td[1].innerText.trim(),
                    td[2].innerText.trim(),
                    td[3].innerText.trim(),
                    Number(td[4].innerText.replace(/,/g, "")),
                    Number(td[5].innerText.replace(/,/g, "")),
                    Number(td[6].innerText.replace(/,/g, ""))
                ]);

            });

            // Row Formatting
            worksheet.eachRow((row, rowNumber) => {

                if (rowNumber <= 5) return;

                row.eachCell((cell, col) => {

                    cell.border = {
                        top: { style: "thin" },
                        left: { style: "thin" },
                        bottom: { style: "thin" },
                        right: { style: "thin" }
                    };

                    // Alternate Row Color
                    if (rowNumber % 2 === 0) {
                        cell.fill = {
                            type: "pattern",
                            pattern: "solid",
                            fgColor: { argb: "F7F7F7" }
                        };
                    }

                    // Amount Columns
                    if (col >= 5 && col <= 7) {
                        cell.numFmt = '#,##0';
                        cell.alignment = { horizontal: "right" };
                    }

                    // Debit
                    if (col === 5) {
                        cell.font = { color: { argb: "008000" } };
                    }

                    // Credit
                    if (col === 6) {
                        cell.font = { color: { argb: "FF0000" } };
                    }

                    // Balance
                    if (col === 7) {
                        cell.font = {
                            bold: true,
                            color: { argb: "0000FF" }
                        };
                    }

                });

            });

            // Auto Width
            worksheet.columns.forEach(column => {

                let max = 12;

                column.eachCell({ includeEmpty: true }, cell => {

                    const len = cell.value ? cell.value.toString().length : 10;

                    if (len > max)
                        max = len;

                });

                column.width = max + 3;

            });

            // Freeze Header
            worksheet.views = [{
                state: "frozen",
                ySplit: 5
            }];

            // Auto Filter
            worksheet.autoFilter = {
                from: "A5",
                to: "G5"
            };

            // Download
            const buffer = await workbook.xlsx.writeBuffer();
            const today = new Date();
            const formattedDate = today.getFullYear() + '-' +
                String(today.getMonth() + 1).padStart(2, '0') + '-' +
                String(today.getDate()).padStart(2, '0');
            // Remove invalid filename characters
            fileName = fileName.replace(/[\\/:*?"<>|]/g, '_');

            saveAs(
                new Blob([buffer], {
                    type: "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet"
                }),
                `${fileName}_${formattedDate}.xlsx`
            );

        }
    </script>
