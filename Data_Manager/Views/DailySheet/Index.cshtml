
<style>
    table {
        width: 100% !important;
    }

    tbody {
        background: white;
        color: black;
    }

    thead {
        background: #5e5c58f2;
        border: 0.2px solid white;
        font-size: medium;
    }

    .col {
        text-align: center;
    }

    .ffooter {
        background: #cecaca96;
        font-size: medium;
        border-top: 2px solid #ffc806;
        text-align: center;
    }

    .icon-list,.pointer {
        cursor: pointer;
    }
    .dataTables_wrapper {
        overflow: auto;
        max-height:122pt;
        height:122pt;
    }

    /* ===== Popup Big Size + Professional Design ===== */
    #Searchmodel .modal-dialog {
        width: 900px !important;
        margin: 30px auto !important;
    }
    #Searchmodel .modal-content {
        background: linear-gradient(rgb(25, 49, 70), rgb(12, 36, 63)) !important;
        border: 1px solid #3d4a5d !important;
        border-radius: 8px !important;
        border-bottom: 3px solid #ffc806 !important;
        box-shadow: 0 10px 30px rgba(0,0,0,0.8) !important;
        color: #fff !important;
    }
    #Searchmodel .modal-header {
        background: rgba(0,0,0,0.3) !important;
        border-bottom: 2px solid #ffc806 !important;
        padding: 12px 20px !important;
    }
    #Searchmodel .modal-title {
        color: #ffc806 !important;
        font-weight: bold !important;
        font-size: 16px !important;
    }
    #Searchmodel .modal-body {
        padding: 20px !important;
    }
    #Searchmodel .well {
        background: transparent !important;
        border: none !important;
        box-shadow: none !important;
        padding: 0 !important;
        margin: 0 !important;
    }
    #Searchmodel .block {
        background: rgba(255,255,255,0.05) !important;
        border: 1px solid #3e4c60 !important;
        border-radius: 6px !important;
        margin-bottom: 0 !important;
    }
    #Searchmodel .block .header {
        background: rgba(0,0,0,0.25) !important;
        border-bottom: 1px solid #3e4c60 !important;
        padding: 10px 15px !important;
    }
    #Searchmodel .block .header h2 {
        color: #ffc806 !important;
        font-size: 15px !important;
        font-weight: 700 !important;
        margin: 0 !important;
    }
    #Searchmodel .block .content {
        padding: 18px !important;
    }
    #Searchmodel .editor-label {
        color: #b8d4e8 !important;
        font-weight: 600 !important;
        font-size: 12px !important;
        margin-bottom: 5px !important;
        text-transform: uppercase;
        letter-spacing: 0.3px;
    }
    #Searchmodel .form-control,
    #Searchmodel .editor-field input,
    #Searchmodel .editor-field select {
        background-color: #0d1b2a !important;
        border: 1px solid #4a5a73 !important;
        color: #fff !important;
        height: 36px !important;
        border-radius: 4px !important;
        font-size: 13px !important;
        padding: 5px 10px !important;
    }
    #Searchmodel .form-control:focus,
    #Searchmodel .editor-field input:focus,
    #Searchmodel .editor-field select:focus {
        border-color: #ffc806 !important;
        box-shadow: 0 0 5px rgba(255,200,6,0.4) !important;
        outline: none !important;
    }
    #Searchmodel select option {
        background: #1a2a3a !important;
        color: #fff !important;
    }
    #Searchmodel .input-group-addon {
        background-color: #132233 !important;
        border: 1px solid #4a5a73 !important;
        color: #ffc806 !important;
    }
    #Searchmodel .btn-base {
        background: #00a65a !important;
        border: 1px solid #008d4c !important;
        color: #fff !important;
        font-weight: bold !important;
        font-size: 13px !important;
        padding: 7px 25px !important;
        border-radius: 4px !important;
        margin-top: 10px !important;
    }
    #Searchmodel .btn-base:hover {
        background: #008d4c !important;
        box-shadow: 0 0 8px rgba(0,166,90,0.5) !important;
    }
    #Searchmodel .close {
        color: #fff !important;
        opacity: 0.8 !important;
        font-size: 24px !important;
        text-shadow: none !important;
    }
    #Searchmodel .close:hover {
        color: #ffc806 !important;
        opacity: 1 !important;
    }
    .ui-datepicker, #ui-datepicker-div {
        z-index: 99999 !important;
    }
</style>

