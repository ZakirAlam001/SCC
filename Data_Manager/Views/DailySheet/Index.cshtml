<script>
    function showhide(id) {
        $(".addform").addClass("hide");
        $(id).removeClass("hide");

        // Dynamically update modal header title based on active form
        var title = $(id).find(".header h2").text().trim();
        if (title) {
            $("#modalTitle").html('<i class="widget-icon widget-icon-dark icon-plus"></i> ' + title);
        }

        // Initialize and re-bind datepicker on all datepicker inputs in active form
        $(id).find('.datepicker1').datepicker({ dateFormat: 'd-M-yy' });

        // Auto-fill active date in datepicker if empty
        var currentActiveDate = $("#activedate").val();
        if (currentActiveDate) {
            $(id).find(".datepicker1").each(function () {
                if (!$(this).val()) {
                    $(this).val(currentActiveDate);
                }
            });
        }
    }

    $(".close, [data-dismiss=\"modal\"]").click(function () {
        $("#Searchmodel").find("input:not([readonly]), select").val("");
        $("#Searchmodel").find(".OTotalAmount, .OVTotalAmount").val("0");
        $("#Searchmodel").find(".ORate, .OWeight, .OVRate, .OVWeight").val("0");
    });
</script>







       

