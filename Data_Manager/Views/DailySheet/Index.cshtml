
<style>
    table {
        width: 100% !important;
    }

    tbody {
        background: white;
        color: black;
    }

    thead {
        background: #5e5c58f2;
        border: 0.2px solid white;
        font-size: medium;
    }

    .col {
        text-align: center;
    }

    .ffooter {
        background: #cecaca96;
        font-size: medium;
        border-top: 2px solid #ffc806;
        text-align: center;
    }

    .icon-list,.pointer {
        cursor: pointer;
    }
    .dataTables_wrapper {
        overflow: auto;
        max-height:122pt;
        height:122pt;
    }

        /* Modal Centering & Big Size (overrides Bootstrap 3.0.0 left: 50% bug) */
    #Searchmodel .modal-dialog {
        position: relative !important;
        left: auto !important;
        right: auto !important;
        width: 90% !important;
        max-width: 950px !important;
        margin: 30px auto !important;
    }
    /* Hide inner duplicate block header inside modal so only modal-header is visible */
    #Searchmodel .block .header {
        display: none !important;
    }
    #Searchmodel .block {
        background: transparent !important;
        border: none !important;
        box-shadow: none !important;
        margin-bottom: 0 !important;
    }
    #Searchmodel .block .content {
        padding: 5px 0 !important;
    }
    .ui-datepicker, #ui-datepicker-div {
        z-index: 99999 !important;
    }
</style>

