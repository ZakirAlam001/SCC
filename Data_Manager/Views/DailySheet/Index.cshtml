@using (Html.BeginForm("Index", "GL_Transaction", FormMethod.Post, new { @id = "validate" }))
{
    @Html.AntiForgeryToken()
    @Html.ValidationSummary(true)

    <div class="modal fade" id="Searchmodel" tabindex="-1" role="dialog" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header text-center">
                    <button type="button" class="close" data-dismiss="modal" aria-hidden="true">&times;</button>
                    <h4 class="modal-title" id="modalTitle"> Search Record </h4>
                </div>
                <div class="modal-body">
                    <!-- <form role="form"> -->
                    <div class="well">

                        <div class="hide addform row searchform">
                            <div class="col-md-4">
                                <div class="editor-label">Users / Sales Item / Vendor</div>
                                <div class="editor-field">
                                    @Html.DropDownList("Stock_ID", null, "Select Sales Item", new { @class = "validate[required] form-control", style = "margin-bottom: 6px;" })
                                    @Html.DropDownList("VendorId", null, "Vendor Name", new { @class = "validate[required] form-control" })
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="editor-label">From Date</div>
                                <div class="editor-field">
                                    <div class="input-group">
                                        <div class="input-group-addon"><span class="icon-calendar-empty"></span></div>
                                        <input name="fromdate" id="fromdate" type="text" class="datepicker1 form-control" />
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="editor-label">To Date</div>
                                <div class="editor-field">
                                    <div class="input-group">
                                        <div class="input-group-addon"><span class="icon-calendar-empty"></span></div>
                                        <input name="todate" id="todate" type="text" class="datepicker1 form-control" />
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div id="customerpayment" class="row hide addform customerpayment">
                            <div class="block">
                                <div class="header">
                                    <h2><i class="widget-icon widget-icon-dark icon-plus"></i> Add Customer Payment</h2>
                                </div>
                                <div class="content">
                                    <div class="row">
                                        <div class="col-md-4">
                                            <div class="editor-label">Name</div>
                                            <div class="editor-field">
                                                @Html.DropDownList("EmpID", null, "Select", new { @class = "validate[required] form-control" })
                                            </div>
                                        </div>
                                        <div class="col-md-4">
                                            <div class="editor-label">Payment Type</div>
                                            <div class="editor-field">
                                                <select class="form-control" id="Payment_Type" name="Payment_Type">
                                                    <option value="">Select</option>
                                                    <option value="Cash">Cash</option>
                                                    <option value="Bank">Bank</option>
                                                    <option value="Cheque">Cheque</option>
                                                </select>
                                            </div>
                                        </div>
                                        <div class="col-md-4">
                                            <div class="editor-label">Amount</div>
                                            <div class="editor-field">
                                                <input class="validate[required] form-control" data-val="true" data-val-number="The field Amount must be a number." id="Amount" name="Amount" type="number" required>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="row" style="margin-top: 10px;">
                                        <div class="col-md-4">
                                            <div class="editor-label">Date</div>
                                            <div class="editor-field">
                                                <div class="input-group">
                                                    <span class="input-group-addon"><i class="icon-calendar-empty"></i></span>
                                                    <input class="datepicker1 validate[required] form-control hasDatepicker" data-val="true" data-val-date="The field Recv_Date must be a date." id="Recv_Date" name="Recv_Date" type="text" value="" autocomplete="off" required>
                                                </div>
                                            </div>
                                        </div>
                                        <div class="col-md-8">
                                            <div class="editor-label">Description</div>
                                            <div class="editor-field">
                                                <input class="form-control" id="Customerdescription" type="text" required>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="row">
                                        <div class="col-md-12"><hr style="margin: 15px 0 10px 0;" /></div>
                                        <div class="col-md-12 text-right">
                                            <button type="button" class="btn btn-base" onclick="CustomerPayment();"><i class="icon-save"></i> Save</button>
                                            <button type="button" class="btn btn-default" data-dismiss="modal">Cancel</button>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="hide addform row vendorpayment">
                            <div class="block">
                                <div class="header">
                                    <h2><i class="widget-icon widget-icon-dark icon-plus"></i> Add Vendor Payment</h2>
                                </div>
