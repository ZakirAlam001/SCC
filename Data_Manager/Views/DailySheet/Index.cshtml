                    <!-- <form role="form"> -->
                    <div class="well">

                        <div class=" hide addform row">
                            <div class="col-lg-4">
                                <div class="editor-label">
                                    Users
                                </div>
                                <div class="editor-field">
                                    @*@*   @Html.DropDownList("EmpID", null, "Select SO")*@

                                    @Html.DropDownList("Stock_ID", null, "Select Sales Item", new { @class = "validate[required] form-control" })
                                    @*   @Html.DropDownList("EmpID", null, "Customer Name", new { @class = "validate[required] form-control" })*@
                                    @Html.DropDownList("VendorId", null, "Vendor Name", new { @class = "validate[required] form-control" })
                                </div>
